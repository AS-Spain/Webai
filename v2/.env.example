# Desarrollo normal. NO son credenciales. Copia a .env y expórtalo en tu shell.
NODE_ENV=development
PORT=3002
APP_BASE_URL=http://localhost:5174
V2_TIME_ZONE=Europe/Madrid
# BOOTSTRAP_TOKEN vacío: generar automáticamente, solo consola del operador.
BOOTSTRAP_TOKEN=
# Vacíos: archivos separados en data/, privados y persistentes. No perderlos.
V2_AI_ENCRYPTION_KEY=
V2_INTEGRATIONS_ENCRYPTION_KEY=
# Opcional: orígenes exactos del motor de IA. Nunca autorizar metadatos o Internet abierto.
V2_AI_ALLOWED_ORIGINS=
# Opcional: frontend adicional del gateway, sin comodines. No habilita CORS cruzado.
V2_ALLOWED_WEB_ORIGINS=
# Solo IP/CIDR del proxy de confianza que sustituye los headers reenviados.
V2_TRUSTED_PROXIES=
# La demo pública no consume recursos del motor salvo decisión explícita del operador.
V2_DEMO_AI_ENABLED=false
V2_REQUEST_LOGS=false
# Para SMTP, configurar en privado: SMTP_HOST/PORT/SECURE/USER/PASSWORD/FROM.
# Para rutas alternativas: V2_DB_PATH y V2_DEMO_DB_PATH (nunca el mismo archivo).
